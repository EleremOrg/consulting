---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import Section from '@components/Section.astro';
import { SITE } from '~/consts';
import { offerings, pillars, steps, stacks } from '~/data/site';

/* JSON-LD: ProfessionalService + each offering as a Service. */
const professionalServiceLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  areaServed: 'Worldwide',
  serviceType: [
    'Software performance engineering',
    'Software architecture',
    'Reliability engineering',
    'Engineering process improvement',
    'Cloud cost optimization',
  ],
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};

const serviceLds = offerings.map((o) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: o.title,
  description: o.summary,
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  areaServed: 'Worldwide',
  serviceType: o.title,
  url: `${SITE.url}/#${o.id}`,
}));
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  jsonLd={[professionalServiceLd, ...serviceLds]}
>
  <Hero
    eyebrow="Engineering that delivers lasting value"
    title="Make engineering"
    titleAccent="compound, not cost."
    description="We help you pay back tech debt and implement the processes to achieve your goals for the long term."
    primaryCta={{ href: '#book', label: 'Book intro call' }}
    secondaryCta={{ href: '#services', label: 'How we work' }}
  />

  {/* ── Differentiation: tagline + three pillars ─────────────────── */}
  <Section
    eyebrow="How we think"
    title="Less effort, more throughput"
    description="A small set of changes drives most of the gain in any system. Our work is finding them, shipping them, and giving your team the method to find the next ones on their own."
  >
    <ul class="grid gap-5 md:grid-cols-3">
      {
        pillars.map((p, i) => (
          <li class="card group relative overflow-hidden p-6 transition-transform hover:-translate-y-0.5">
            <div
              aria-hidden="true"
              class:list={[
                'absolute -right-12 -top-12 h-32 w-32 rounded-full bg-gradient-to-br opacity-30 blur-2xl transition-opacity group-hover:opacity-50',
                p.accent,
              ]}
            />
            <p class="font-mono text-[11px] uppercase tracking-widest text-brand-600">
              0{i + 1}
            </p>
            <h3 class="mt-2 text-lg font-semibold text-ink-900">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{p.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ── Services: merged offerings with full detail ──────────────── */}
  <Section
    id="services"
    eyebrow="What we do"
    title="Three places we go deep"
    description="Code that runs hot. Architecture that has to evolve. The engineering practice that holds it together."
    tone="sand"
  >
    <div class="grid gap-12 lg:grid-cols-12">
      {/* Sticky TOC at lg+ */}
      <aside class="hidden lg:col-span-3 lg:block">
        <nav aria-label="Services" class="sticky top-28">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">
            Jump to
          </p>
          <ul class="mt-4 space-y-2 text-sm">
            {
              offerings.map((o, i) => (
                <li>
                  <a
                    href={`#${o.id}`}
                    class="group flex items-baseline gap-3 text-slate-600 hover:text-ink-900"
                  >
                    <span class="font-mono text-[10px] tracking-widest text-slate-400 group-hover:text-brand-600">
                      0{i + 1}
                    </span>
                    <span>{o.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href="#book"
            class="mt-8 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800"
          >
            Book intro call <span aria-hidden="true">→</span>
          </a>
        </nav>
      </aside>

      <div class="lg:col-span-9">
        <div class="space-y-12">
          {
            offerings.map((o, i) => (
              <article id={o.id} class="scroll-mt-28">
                {/* Header strip with gradient accent */}
                <header
                  class:list={[
                    'relative overflow-hidden rounded-3xl bg-gradient-to-br p-8 text-white sm:p-10',
                    o.accent,
                  ]}
                >
                  <div aria-hidden="true" class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-white/15 blur-3xl"></div>
                  <div aria-hidden="true" class="absolute -left-16 bottom-[-6rem] h-56 w-56 rounded-full bg-accent-300/20 blur-3xl"></div>

                  <p class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/90 backdrop-blur">
                    0{i + 1} · {o.eyebrow}
                  </p>
                  <h3 class="relative mt-5 max-w-2xl text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
                    {o.title}
                  </h3>
                  <p class="relative mt-4 max-w-xl text-white/85">{o.summary}</p>
                </header>

                {/* Two-column body: what we do · outcomes we measure */}
                <div class="mt-6 grid gap-6 lg:grid-cols-12">
                  <div class="card lg:col-span-7 p-6 sm:p-7">
                    <h4 class="text-[11px] font-semibold uppercase tracking-widest text-slate-500">
                      What we do
                    </h4>
                    <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-slate-700">
                      {o.activities.map((a) => (
                        <li class="flex gap-2">
                          <span aria-hidden="true" class="mt-1 text-accent-500">→</span>
                          <span>{a}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="card-tinted lg:col-span-5 p-6 sm:p-7">
                    <h4 class="text-[11px] font-semibold uppercase tracking-widest text-slate-500">
                      Outcomes we measure
                    </h4>
                    <ul class="mt-3 grid grid-cols-1 gap-1.5 text-sm text-slate-700 sm:grid-cols-2">
                      {o.outcomes.map((m) => (
                        <li class="flex items-start gap-2">
                          <span aria-hidden="true" class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>
                          <span>{m}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                {/* Selected wins specific to this offering */}
                <div class="mt-6">
                  <h4 class="text-[11px] font-semibold uppercase tracking-widest text-slate-500">
                    Some results
                  </h4>
                  <ul class="mt-3 grid gap-4 sm:grid-cols-2">
                    {o.wins.map((w) => (
                      <li class="rounded-2xl border border-slate-200/80 bg-white p-5">
                        <div class="flex items-baseline justify-between gap-3">
                          <p class="font-display text-2xl font-bold tracking-tight text-ink-900">
                            {w.metric}
                          </p>
                          <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                            {w.label}
                          </p>
                        </div>
                        <p class="mt-2 text-sm leading-relaxed text-slate-600">
                          {w.detail}
                        </p>
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  {/* ── Methodology: Find · Fix · Compound ────────────────────────── */}
  <Section
    eyebrow="Our approach"
    title="Find. Fix. Compound."
    description="A predictable three-step methodology that delivers consistent results, from quick wins to long-term transformations."
  >
    <ol class="relative grid gap-10 md:grid-cols-3 md:gap-6">
      {/* Connecting hairline */}
      <div
        aria-hidden="true"
        class="absolute left-4 top-4 hidden h-0.5 w-[calc(100%-2rem)] bg-gradient-to-r from-brand-300 via-accent-400 to-brand-500 md:block"
      ></div>
      {
        steps.map((step, i) => (
          <li class="relative">
            <span
              class:list={[
                'relative z-10 inline-flex h-8 w-8 items-center justify-center rounded-full text-xs font-semibold text-white shadow-sm',
                i === 0 ? 'bg-brand-600' : i === 1 ? 'bg-accent-500' : 'bg-ink-900',
              ]}
            >
              0{i + 1}
            </span>
            <h3 class="mt-4 text-base font-semibold text-ink-900">{step.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* ── Stacks strip — competence anchor + SEO ───────────────────── */}
  <section aria-label="Stacks we go deep on" class="border-y border-slate-200/60 bg-sand-50/60">
    <div class="container-wide flex flex-col items-center gap-6 py-10 lg:flex-row lg:gap-10">
      <p class="shrink-0 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
        We go deep on
      </p>
      <ul class="flex flex-wrap items-center gap-2 lg:flex-1 lg:justify-end lg:gap-3">
        {
          stacks.map((s) => (
            <li>
              <span class="inline-flex items-center rounded-full bg-white/70 px-3 py-1.5 text-sm font-medium text-slate-600 ring-1 ring-inset ring-slate-200/70">
                {s}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Cal.com booking ──────────────────────────────────────────── */}
  <section id="book" class="container-wide py-20 scroll-mt-28">
    <div class="mx-auto max-w-2xl text-center">
      <p class="flex justify-center"><span class="eyebrow">Book a 30-min intro call</span></p>
      <h2 class="mt-3 h-section">Tell us what's slowing you down.</h2>
      <p class="mt-4 text-lg text-slate-600">
        Pick any slot — no obligation. Or write to
        <a href={`mailto:${SITE.email}`} class="font-semibold text-brand-700 hover:text-brand-800">{SITE.email}</a>.
      </p>
    </div>

    {/* Cal.com inline embed mount point — no wrapper, sizes itself.
        min-height reserves space before load to avoid layout shift. */}
    <div
      id="my-cal-inline-30min"
      class="mt-10 w-full"
      style="min-height:560px"
    />
  </section>

  {/* Cal.com loader. is:inline emits the snippet verbatim (Cal's IIFE expects to run as-is).
      requestIdleCallback defers the network call for embed.js until the browser is idle,
      so first paint / LCP / INP are not affected for users who never reach this section. */}
  <script is:inline defer>
    (function () {
      function loadCal() {
        (function (C, A, L) {
          let p = function (a, ar) { a.q.push(ar); };
          let d = C.document;
          C.Cal = C.Cal || function () {
            let cal = C.Cal; let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {}; cal.q = cal.q || [];
              d.head.appendChild(d.createElement("script")).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () { p(api, arguments); };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === "string") {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ["initNamespace", namespace]);
              } else { p(cal, ar); }
              return;
            }
            p(cal, ar);
          };
        })(window, "https://app.cal.eu/embed/embed.js", "init");

        Cal("init", "30min", { origin: "https://app.cal.eu" });
        Cal.ns["30min"]("inline", {
          elementOrSelector: "#my-cal-inline-30min",
          config: { layout: "month_view", useSlotsViewOnSmallScreen: "true" },
          calLink: "lucas-montes-9vahqq/30min",
        });
        Cal.ns["30min"]("ui", { hideEventTypeDetails: false, layout: "month_view" });
      }

      if ("requestIdleCallback" in window) {
        requestIdleCallback(loadCal, { timeout: 2500 });
      } else {
        setTimeout(loadCal, 1500);
      }
    })();
  </script>
</BaseLayout>
