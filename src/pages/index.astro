---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import { SITE } from "~/consts";

/* ──────────────────────────────────────────────────────────────────
   Three pillars under the hero — TOC + Lean + value-engineering blend.
   ────────────────────────────────────────────────────────────────── */
const pillars = [
  {
    title: "Root-cause first",
    body: "We find the binding constraint — the slow query, the synchronous handoff, the missing index — instead of optimizing what's loud.",
    accent: "from-brand-500 to-brand-700",
  },
  {
    title: "Built to last",
    body: "Refactors, ADRs and runbooks that compound after we leave. No throwaway demos, no over-the-wall handoffs.",
    accent: "from-accent-500 to-brand-600",
  },
  {
    title: "Maximum return per effort",
    body: "Outcome divided by engineering hours. Often that means less code, fewer services, fewer fires — not more.",
    accent: "from-amber-500 to-pink-500",
  },
];

/* ──────────────────────────────────────────────────────────────────
   Three offerings — Code · Architecture · Culture/Process.
   Each card has a shape parallel to /services for consistency.
   ────────────────────────────────────────────────────────────────── */
const offerings = [
  {
    eyebrow: "Code",
    title: "Codebase performance & quality",
    summary:
      "Your code works — but it's slow, expensive to run, hard to change, and untested where it counts. We go in and fix that.",
    bullets: [
      "Profile critical paths · refactor hot spots",
      "Migrate where ROI is clear (Flask → FastAPI, sync → async, Tokio…)",
      "Coverage where coverage actually buys risk reduction",
    ],
    href: "/services#code",
    accent: "from-brand-600 via-brand-700 to-ink-900",
    featured: true,
  },
  {
    eyebrow: "Architecture",
    title: "Architecture for scale & change",
    summary:
      "We help you decide the next two years of platform direction — then ship the first slice, so the plan survives contact with reality.",
    bullets: [
      "Independent review & risk register",
      "Migration strategy: monolith → services, sync → async",
      "DDD, hexagonal, strangler-fig, ADRs",
    ],
    href: "/services#architecture",
    accent: "from-accent-500 to-brand-600",
  },
  {
    eyebrow: "Culture & process",
    title: "Engineering practice that compounds",
    summary:
      "Even great code rots in a team that ships slowly. We build the engineering practice — metrics, reviews, observability, mentoring.",
    bullets: [
      "DORA metrics, code review & CI workflows",
      "Observability (OTel, Prometheus, Grafana, Loki, Tempo)",
      "Mentoring, ADRs, postmortem ritual",
    ],
    href: "/services#culture",
    accent: "from-amber-500 to-pink-500",
  },
];

/* ──────────────────────────────────────────────────────────────────
   Selected results — real, anonymized numbers from past engagements.
   These appear on the home page (top wins) and the services page (full).
   ────────────────────────────────────────────────────────────────── */
const wins = [
  {
    metric: "10×",
    label: "lower latency",
    detail: "ML-serving microservice: 5s → <500ms via redesign and better data structures.",
  },
  {
    metric: "−80%",
    label: "memory + 6× faster",
    detail: "ETL pipeline: 2h → 20min, memory −80% via profiling and hot-path rewrites.",
  },
  {
    metric: "4×",
    label: "throughput",
    detail: "MySQL event store: memory −70%, CPU −20%, failure rate −45%, MTTR −65%.",
  },
  {
    metric: "−50%",
    label: "memory · −20% CPU",
    detail: "Custom Rust + Tokio proxy network — better resource efficiency at scale.",
  },
  {
    metric: "3×",
    label: "deploy frequency",
    detail: "E-commerce ingestion (Shopify / Woo / Presta) refactored with strangler pattern. Lead time −60%.",
  },
  {
    metric: "12 → 92%",
    label: "test coverage",
    detail: "Across multiple services, plus AI model benchmarks (MAE, R², RMSE) for fast iteration.",
  },
];

/* ──────────────────────────────────────────────────────────────────
   Methodology — Find · Fix · Compound.
   ────────────────────────────────────────────────────────────────── */
const steps = [
  {
    title: "Find",
    body: "We measure first — latency, cost, MTTR, lead time. The constraint reveals itself in the numbers, not the meeting.",
  },
  {
    title: "Fix",
    body: "We ship the change in your repo, with your engineers. PRs, code review, observability — same way your team works.",
  },
  {
    title: "Compound",
    body: "ADRs, runbooks, dashboards. The engagement ends; the value keeps paying interest.",
  },
];

/* ──────────────────────────────────────────────────────────────────
   Stacks we go deep on (visible competence anchor + SEO).
   ────────────────────────────────────────────────────────────────── */
const stacks = [
  "Python",
  "Rust",
  "Postgres",
  "MySQL",
  "FastAPI",
  "Tokio",
  "OpenTelemetry",
  "AWS",
  "Kubernetes",
];

/* ──────────────────────────────────────────────────────────────────
   JSON-LD: ProfessionalService.
   ────────────────────────────────────────────────────────────────── */
const professionalServiceLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  areaServed: "Worldwide",
  serviceType: [
    "Software performance engineering",
    "Software architecture",
    "Reliability engineering",
    "Engineering process improvement",
    "Cloud cost optimization",
  ],
  provider: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
  },
};
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  jsonLd={[professionalServiceLd]}
>
  <Hero
    eyebrow="Engineering for compounding returns"
    title="Make engineering"
    titleAccent="compound, not cost."
    description="We help you pay back tech debt and implement the processes to achieve your goals for the long term."
    primaryCta={{ href: "/contact", label: "Book intro call" }}
    secondaryCta={{ href: "/services", label: "How we work" }}
  />

  {/* ── Differentiation: tagline + three pillars ─────────────────── */}
  <Section
    eyebrow="How we think"
    title="We don't patch symptoms."
    description="We find the constraint, remove the waste, and compound the return — borrowed from lean manufacturing, the theory of constraints, and value engineering, then translated into code."
  >
    <ul class="grid gap-5 md:grid-cols-3">
      {
        pillars.map((p, i) => (
          <li class="card group relative overflow-hidden p-6 transition-transform hover:-translate-y-0.5">
            <div
              aria-hidden="true"
              class:list={[
                "absolute -right-12 -top-12 h-32 w-32 rounded-full bg-gradient-to-br opacity-30 blur-2xl transition-opacity group-hover:opacity-50",
                p.accent,
              ]}
            />
            <p class="font-mono text-[11px] uppercase tracking-widest text-brand-600">
              0{i + 1}
            </p>
            <h3 class="mt-2 text-lg font-semibold text-ink-900">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{p.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ── Three offerings: Code · Architecture · Culture ────────────── */}
  <Section
    eyebrow="What we do"
    title="Three places we go deep"
    description="We work where senior IC judgement makes the biggest difference — code, architecture, and the engineering practice around them."
    tone="sand"
  >
    <div class="grid gap-6 lg:grid-cols-12">
      {/* Featured: Code */}
      <a
        href={offerings[0].href}
        class:list={[
          "group relative col-span-12 overflow-hidden rounded-3xl bg-gradient-to-br p-8 text-white transition-transform hover:-translate-y-0.5 sm:p-10 lg:col-span-7",
          offerings[0].accent,
        ]}
      >
        <div aria-hidden="true" class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-accent-400/30 blur-3xl"></div>
        <div aria-hidden="true" class="absolute -left-16 bottom-[-6rem] h-56 w-56 rounded-full bg-pink-400/20 blur-3xl"></div>

        <p class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/90 backdrop-blur">
          {offerings[0].eyebrow}
        </p>
        <h3 class="relative mt-5 max-w-xl text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
          {offerings[0].title}
        </h3>
        <p class="relative mt-4 max-w-md text-white/85">{offerings[0].summary}</p>

        <ul class="relative mt-6 grid gap-2 text-sm text-white/90">
          {
            offerings[0].bullets.map((b) => (
              <li class="flex items-start gap-2">
                <span aria-hidden="true" class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-accent-300"></span>
                <span>{b}</span>
              </li>
            ))
          }
        </ul>

        <p class="relative mt-8 inline-flex items-center gap-1 text-sm font-semibold text-white">
          See how we work in code
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
        </p>
      </a>

      {/* Supporting: Architecture + Culture */}
      <ul class="col-span-12 grid gap-4 lg:col-span-5">
        {
          offerings.slice(1).map((o) => (
            <li>
              <a
                href={o.href}
                class="card group relative block overflow-hidden p-6 transition-transform hover:-translate-y-0.5"
              >
                <div
                  aria-hidden="true"
                  class:list={[
                    "absolute -right-10 -top-10 h-28 w-28 rounded-full bg-gradient-to-br opacity-30 blur-2xl transition-opacity group-hover:opacity-50",
                    o.accent,
                  ]}
                />
                <p class="font-mono text-[11px] uppercase tracking-widest text-brand-600">
                  {o.eyebrow}
                </p>
                <h3 class="mt-1.5 text-lg font-semibold text-ink-900">{o.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-600">
                  {o.summary}
                </p>
                <p class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 group-hover:text-brand-800">
                  Learn more
                  <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-8">
      <a
        href="/services"
        class="inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800"
      >
        See full service detail <span aria-hidden="true">→</span>
      </a>
    </div>
  </Section>

  {/* ── Selected results — full-bleed ink band with real numbers ──── */}
  <section class="relative overflow-hidden bg-ink-900 text-white">
    <div aria-hidden="true" class="absolute inset-0 -z-0">
      <div class="absolute -top-32 -left-20 h-[28rem] w-[28rem] rounded-full bg-brand-500/30 blur-3xl"></div>
      <div class="absolute bottom-[-10rem] right-[-6rem] h-[26rem] w-[26rem] rounded-full bg-accent-500/25 blur-3xl"></div>
    </div>

    <div class="container-wide relative py-20 sm:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow !text-accent-300">Selected results</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
          We commit in numbers, not adjectives.
        </h2>
        <p class="mt-4 text-lg text-slate-300">
          A sample of measurable wins from past engagements — anonymized, all real.
          References available on request.
        </p>
      </div>

      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          wins.map((w, i) => (
            <li
              class:list={[
                "rounded-2xl border-l-2 bg-white/5 p-6 backdrop-blur-sm",
                i % 4 === 0
                  ? "border-accent-400"
                  : i % 4 === 1
                    ? "border-brand-400"
                    : i % 4 === 2
                      ? "border-pink-400"
                      : "border-amber-400",
              ]}
            >
              <p class="font-display text-3xl font-bold leading-none text-white">
                {w.metric}
              </p>
              <p class="mt-1 text-xs font-medium uppercase tracking-wider text-slate-400">
                {w.label}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-slate-300">
                {w.detail}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Methodology: Find · Fix · Compound ────────────────────────── */}
  <Section
    eyebrow="How we work"
    title="Find. Fix. Compound."
    description="A predictable loop that maps onto every engagement, whether the work lasts six weeks or six months."
  >
    <ol class="relative grid gap-10 md:grid-cols-3 md:gap-6">
      {/* Connecting hairline */}
      <div
        aria-hidden="true"
        class="absolute left-4 top-4 hidden h-0.5 w-[calc(100%-2rem)] bg-gradient-to-r from-brand-300 via-accent-400 to-brand-500 md:block"
      ></div>
      {
        steps.map((step, i) => (
          <li class="relative">
            <span
              class:list={[
                "relative z-10 inline-flex h-8 w-8 items-center justify-center rounded-full text-xs font-semibold text-white shadow-sm",
                i === 0
                  ? "bg-brand-600"
                  : i === 1
                    ? "bg-accent-500"
                    : "bg-ink-900",
              ]}
            >
              0{i + 1}
            </span>
            <h3 class="mt-4 text-base font-semibold text-ink-900">{step.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* ── Stacks strip — competence anchor + SEO ───────────────────── */}
  <section aria-label="Stacks we go deep on" class="border-y border-slate-200/60 bg-sand-50/60">
    <div class="container-wide flex flex-col items-center gap-6 py-10 lg:flex-row lg:gap-10">
      <p class="shrink-0 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
        We go deep on
      </p>
      <ul class="flex flex-wrap items-center gap-2 lg:flex-1 lg:justify-end lg:gap-3">
        {
          stacks.map((s) => (
            <li>
              <span class="inline-flex items-center rounded-full bg-white/70 px-3 py-1.5 text-sm font-medium text-slate-600 ring-1 ring-inset ring-slate-200/70">
                {s}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Cal.com booking ──────────────────────────────────────────── */}
  <section id="book" class="container-wide py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="flex justify-center"><span class="eyebrow">Book a 30-min intro call</span></p>
      <h2 class="mt-3 h-section">Tell us what's slowing you down.</h2>
      <p class="mt-4 text-lg text-slate-600">
        Pick any slot — no obligation. Or write to
        <a href={`mailto:${SITE.email}`} class="font-semibold text-brand-700 hover:text-brand-800">{SITE.email}</a>.
      </p>
    </div>

    {/* Cal.com inline embed mount point — no wrapper, sizes itself.
        min-height reserves space before load to avoid layout shift. */}
    <div
      id="my-cal-inline-30min"
      class="mt-10 w-full"
      style="min-height:560px"
    />

    <p class="mt-4 text-center text-xs text-slate-500">
      Booking powered by <a href="https://cal.com" rel="noopener" class="underline hover:text-ink-900">Cal.com</a>.
      Prefer a written brief? <a href="/contact" class="underline hover:text-ink-900">Use the contact form</a>.
    </p>
  </section>

  {/* Cal.com loader. is:inline emits the snippet verbatim (Cal's IIFE expects to run as-is).
      requestIdleCallback defers the network call for embed.js until the browser is idle,
      so first paint / LCP / INP are not affected for users who never reach this section. */}
  <script is:inline defer>
    (function () {
      function loadCal() {
        (function (C, A, L) {
          let p = function (a, ar) { a.q.push(ar); };
          let d = C.document;
          C.Cal = C.Cal || function () {
            let cal = C.Cal; let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {}; cal.q = cal.q || [];
              d.head.appendChild(d.createElement("script")).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () { p(api, arguments); };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === "string") {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ["initNamespace", namespace]);
              } else { p(cal, ar); }
              return;
            }
            p(cal, ar);
          };
        })(window, "https://app.cal.eu/embed/embed.js", "init");

        Cal("init", "30min", { origin: "https://app.cal.eu" });
        Cal.ns["30min"]("inline", {
          elementOrSelector: "#my-cal-inline-30min",
          config: { layout: "month_view", useSlotsViewOnSmallScreen: "true" },
          calLink: "lucas-montes-9vahqq/30min",
        });
        Cal.ns["30min"]("ui", { hideEventTypeDetails: false, layout: "month_view" });
      }

      if ("requestIdleCallback" in window) {
        requestIdleCallback(loadCal, { timeout: 2500 });
      } else {
        setTimeout(loadCal, 1500);
      }
    })();
  </script>
</BaseLayout>
