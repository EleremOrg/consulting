---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import { SITE } from "~/consts";
import { offerings, steps } from "~/data/site";

/* JSON-LD: ProfessionalService + each offering as a Service. */
const professionalServiceLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  areaServed: "Worldwide",
  serviceType: [
    "Software performance engineering",
    "Software architecture",
    "Reliability engineering",
    "Engineering process improvement",
    "Cloud cost optimization",
  ],
  provider: { "@type": "Organization", name: SITE.name, url: SITE.url },
};

const serviceLds = offerings.map((o) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: o.title,
  description: o.summary,
  provider: { "@type": "Organization", name: SITE.name, url: SITE.url },
  areaServed: "Worldwide",
  serviceType: o.title,
  url: `${SITE.url}/#${o.id}`,
}));
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  jsonLd={[professionalServiceLd, ...serviceLds]}
>
  <Hero
    eyebrow="Your codebase should feel like an asset, not a burden"
    title="Make engineering"
    titleAccent="feel effortless."
    description="Tech debt, velocity loss, rising costs, quality erosion — Elerem addresses the root causes so your team delivers with confidence."
    primaryCta={{ href: "#book", label: "Book intro call" }}
    secondaryCta={{ href: "#services", label: "How we work" }}
  />

  {/* ── Methodology: Find · Standardize · Compound ────────────────── */}
  <Section
    eyebrow="Our approach"
    title="Find. Standardize. Compound."
    description="From faster code to systems that scale and a team that owns its process."
  >
    <ol class="relative grid gap-10 md:grid-cols-3 md:gap-6">
      {/* Connecting hairline */}
      <div
        aria-hidden="true"
        class="absolute left-4 top-4 hidden h-0.5 w-[calc(100%-2rem)] bg-gradient-to-r from-brand-300 via-accent-400 to-brand-900 md:block"
      >
      </div>
      {
        steps.map((step, i) => (
          <li class="relative">
            <span
              class:list={[
                "relative z-10 inline-flex h-8 w-8 items-center justify-center rounded-full text-xs font-semibold shadow-sm",
                i === 0
                  ? "bg-brand-700 text-white"
                  : i === 1
                    ? "bg-accent-400 text-brand-900"
                    : "bg-brand-900 text-white",
              ]}
            >
              0{i + 1}
            </span>
            <h3 class="mt-4 text-base font-semibold text-ink-900">
              {step.title}
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* ── Services: merged offerings with full detail ──────────────── */}
  <Section
    id="services"
    eyebrow="How value compounds"
    title="Remove constraints across engineering"
    description="Delivery problems rarely come from a single source. Bottlenecks emerge across systems, workflows, and operational practices. Elerem embeds directly into engineering organizations to improve throughput, reliability, and long-term scalability."
    tone="sand"
  >
    <div class="grid gap-12 lg:grid-cols-12">
      {/* Sticky TOC at lg+ */}
      <aside class="hidden lg:col-span-3 lg:block">
        <nav aria-label="Services" class="sticky top-28">
          <p
            class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500"
          >
            Jump to
          </p>
          <ul class="mt-4 space-y-2 text-sm">
            {
              offerings.map((o, i) => (
                <li>
                  <a
                    href={`#${o.id}`}
                    class="group flex items-baseline gap-3 text-slate-600 transition-colors hover:text-ink-900"
                  >
                    <span class="font-mono text-[10px] tracking-widest text-slate-400 transition-colors group-hover:text-accent-700">
                      0{i + 1}
                    </span>
                    <span>{o.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href="#book"
            class="mt-8 inline-flex items-center gap-1 text-sm font-semibold text-brand-900 transition-colors hover:text-accent-700"
          >
            Book intro call <span aria-hidden="true">→</span>
          </a>
        </nav>
      </aside>

      <div class="lg:col-span-9">
        <div class="space-y-12">
          {
            offerings.map((o, i) => (
              <article id={o.id} class="scroll-mt-28">
                {/* Header block — same DNA as the pillar cards above:
                    white surface with a soft accent blob in the corner. */}
                <header class="card group relative overflow-hidden p-8 sm:p-10">
                  <div
                    aria-hidden="true"
                    class:list={[
                      "absolute -right-16 -top-16 h-56 w-56 rounded-full bg-gradient-to-br opacity-30 blur-3xl transition-opacity group-hover:opacity-50",
                      o.accent,
                    ]}
                  />

                  <p class="relative inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-brand-600">
                    <span aria-hidden="true">0{i + 1}</span>
                    <span aria-hidden="true" class="text-slate-300">
                      ·
                    </span>
                    <span>{o.eyebrow}</span>
                  </p>
                  <h3 class="relative mt-3 max-w-2xl text-3xl font-bold leading-tight tracking-tight text-ink-900 sm:text-4xl">
                    {o.title}
                  </h3>
                  <p class="relative mt-4 max-w-xl text-base leading-relaxed text-slate-600">
                    {o.summary}
                  </p>
                </header>

                {/* Two-column body: what we do · outcomes we measure */}
                <div class="mt-6 grid gap-6 lg:grid-cols-12">
                  <div class="card lg:col-span-7 p-6 sm:p-7">
                    <h4 class="text-[11px] font-semibold uppercase tracking-widest text-slate-500">
                      What we do
                    </h4>
                    <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-slate-700">
                      {o.activities.map((a) => (
                        <li class="flex gap-2">
                          <span
                            aria-hidden="true"
                            class="mt-1 font-semibold text-brand-900"
                          >
                            →
                          </span>
                          <span>{a}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="card-tinted lg:col-span-5 p-6 sm:p-7">
                    <h4 class="text-[11px] font-semibold uppercase tracking-widest text-slate-500">
                      Outcomes we measure
                    </h4>
                    <ul class="mt-3 grid grid-cols-1 gap-1.5 text-sm text-slate-700 sm:grid-cols-2">
                      {o.outcomes.map((m) => (
                        <li class="flex items-start gap-2">
                          <span
                            aria-hidden="true"
                            class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500"
                          />
                          <span>{m}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  {/* ── Booking ──────────────────────────────────────────────────── */}
  <section id="book" class="container-wide py-20 scroll-mt-28">
    <div class="mx-auto max-w-2xl text-center">
      <p class="flex justify-center">
        <span class="eyebrow">Book a 30-min intro call</span>
      </p>
      <h2 class="mt-3 h-section">Let's fix what's slowing you down.</h2>
      <p class="mt-4 text-lg text-slate-600">
        No pitch, no obligation. Just a conversation about what's blocking your
        team — and how we can help. Or write to
        <a
          href={`mailto:${SITE.email}`}
          class="font-semibold text-brand-900 transition-colors hover:text-accent-700"
          >{SITE.email}</a
        >.
      </p>
    </div>

    {
      /* Cal.com inline embed mount point — no wrapper, sizes itself.
        min-height reserves space before load to avoid layout shift. */
    }
    <div id="my-cal-inline-30min" class="mt-10 w-full" style="min-height:560px">
    </div>
  </section>

  {
    /* Cal.com loader. is:inline emits the snippet verbatim (Cal's IIFE expects to run as-is).
      requestIdleCallback defers the network call for embed.js until the browser is idle,
      so first paint / LCP / INP are not affected for users who never reach this section. */
  }
  <!-- Cal inline embed code begins -->
  <script is:inline defer>
    (function (C, A, L) {
      let p = function (a, ar) {
        a.q.push(ar);
      };
      let d = C.document;
      C.Cal =
        C.Cal ||
        function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () {
              p(api, arguments);
            };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
    })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", "30min", { origin: "https://app.cal.com" });

    Cal.ns["30min"]("inline", {
      elementOrSelector: "#my-cal-inline-30min",
      config: { layout: "month_view", useSlotsViewOnSmallScreen: "true" },
      calLink: "lucas-montes/30min",
    });

    Cal.ns["30min"]("ui", {
      hideEventTypeDetails: false,
      layout: "month_view",
    });
  </script>
  <!-- Cal inline embed code ends -->
</BaseLayout>
