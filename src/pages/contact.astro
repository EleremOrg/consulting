---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import { SITE } from '~/consts';

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${SITE.name}`,
  url: `${SITE.url}/contact`,
  mainEntity: {
    '@type': 'Organization',
    name: SITE.name,
    email: SITE.email,
    url: SITE.url,
  },
};
---

<BaseLayout
  title="Contact"
  description={`Start a conversation with ${SITE.name}. Tell us about your engineering challenge and we'll come back within one business day.`}
  jsonLd={[contactLd]}
>
  <Section
    eyebrow="Contact"
    title="Let's talk about your engineering challenge"
    description="Tell us a little about what you're working on. We reply to every message within one business day — and we'll be honest if we're not the right fit."
  >
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <form
          name="contact"
          method="POST"
          action="https://formspree.io/f/your-form-id"
          class="card space-y-5 p-6 sm:p-7"
        >
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-medium text-ink-900">Your name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-ink-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-brand-500"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-ink-900">Work email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-ink-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-brand-500"
              />
            </div>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="company" class="block text-sm font-medium text-ink-900">Company</label>
              <input
                id="company"
                name="company"
                type="text"
                autocomplete="organization"
                class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-ink-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-brand-500"
              />
            </div>
            <div>
              <label for="role" class="block text-sm font-medium text-ink-900">Your role <span class="font-normal text-slate-400">(optional)</span></label>
              <input
                id="role"
                name="role"
                type="text"
                autocomplete="organization-title"
                placeholder="CTO, VP Eng, Founder…"
                class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-ink-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-brand-500"
              />
            </div>
          </div>
          <div>
            <label for="engagement" class="block text-sm font-medium text-ink-900">What kind of help?</label>
            <select
              id="engagement"
              name="engagement"
              class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-ink-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-brand-500"
            >
              <option value="">Pick one — or leave blank if unsure</option>
              <option>Architecture review / due diligence</option>
              <option>Embedded engineering</option>
              <option>Fractional CTO</option>
              <option>Reliability & performance</option>
              <option>Something else</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-ink-900">How can we help?</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="A sentence or two on the context is plenty."
              class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-ink-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-brand-500"
            ></textarea>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
            <button type="submit" class="btn-primary w-full sm:w-auto">Send message</button>
            <p class="text-xs text-slate-500">No marketing, ever. We reply within 1 business day.</p>
          </div>
        </form>
      </div>

      <aside class="lg:col-span-5">
        <div class="lg:sticky lg:top-28 space-y-4">
          <div class="card-tinted p-6">
            <p class="eyebrow">Prefer email?</p>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">
              Write to <a href={`mailto:${SITE.email}`} class="font-semibold text-brand-700 hover:text-brand-800">{SITE.email}</a>.
              A sentence or two on your context is plenty — we'll take it from there.
            </p>
          </div>

          <div class="card p-6">
            <p class="eyebrow">What happens next</p>
            <ol class="mt-4 space-y-3 text-sm text-slate-700">
              <li class="flex gap-3">
                <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 font-mono text-xs font-semibold text-brand-700">1</span>
                <span>We reply within one business day.</span>
              </li>
              <li class="flex gap-3">
                <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 font-mono text-xs font-semibold text-brand-700">2</span>
                <span>30-minute intro call, no obligation.</span>
              </li>
              <li class="flex gap-3">
                <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 font-mono text-xs font-semibold text-brand-700">3</span>
                <span>If we're a fit, a short written proposal with scope &amp; fees.</span>
              </li>
            </ol>
          </div>

          <div class="rounded-2xl border border-dashed border-slate-200 p-5 text-xs text-slate-500">
            <p>
              <strong class="font-semibold text-ink-900">NDA?</strong>
              Mutual NDAs are fine — mention it and we'll turn one around quickly.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
