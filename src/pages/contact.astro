---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import { SITE } from '~/consts';

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${SITE.name}`,
  url: `${SITE.url}/contact`,
  mainEntity: {
    '@type': 'Organization',
    name: SITE.name,
    email: SITE.email,
    url: SITE.url,
  },
};
---

<BaseLayout
  title="Contact"
  description="Not sure if we're the right fit? Share your project and get feedback within one business day."
  jsonLd={[contactLd]}
  >
    {/* ── Contact form ──────────────────────────────────────────────── */}
    <Section
      eyebrow="Get in touch"
      title="Let's discuss your project"
description="Not sure if we're the right fit? No problem. Share what you're working on, whether it's a greenfield rebuild, scaling challenges, or simply needing senior technical leadership, and we'll give you feedback on how we can help. Expect a thoughtful response within one business day."
    >
      <div data-fs-success class="text-sm text-center text-green-600 mb-4">Thanks! We'll be in touch soon.</div>
      <div data-fs-error class="text-sm text-center text-red-500 mb-4">Something went wrong. Please try again.</div>
      <form
        name="contact"
        method="POST"
        action="https://formspree.io/f/mpqbwvqj"
        class="card mx-auto max-w-2xl space-y-5 p-6 sm:p-7"
        id="contact-form"
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="block text-sm font-medium text-ink-900">Full name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              data-fs-field
              class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-ink-900 shadow-sm transition-colors focus:border-accent-400 focus:ring-accent-400"
            />
            <span data-fs-error="name" class="mt-1 text-sm text-red-500"></span>
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-ink-900">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              data-fs-field
              class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-ink-900 shadow-sm transition-colors focus:border-accent-400 focus:ring-accent-400"
            />
            <span data-fs-error="email" class="mt-1 text-sm text-red-500"></span>
          </div>
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-ink-900">Project details</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            placeholder="Tell us about your project, timeline, or team needs..."
            data-fs-field
            class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-ink-900 shadow-sm transition-colors focus:border-accent-400 focus:ring-accent-400"
          ></textarea>
          <span data-fs-error="message" class="mt-1 text-sm text-red-500"></span>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
          <button type="submit" class="btn-primary w-full sm:w-auto" data-fs-submit-btn>Send inquiry</button>
          <p class="text-xs text-slate-500">Expect a reply within 1 business day.</p>
        </div>
      </form>
    </Section>

  {/* ── Cal.com inline embed (same as home page) ──────────────────── */}
  <section id="book" class="container-wide pb-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="flex justify-center"><span class="eyebrow">Want to talk it through?</span></p>
      <h2 class="mt-3 h-section">Book a free consultation</h2>
      <p class="mt-4 text-lg text-slate-600">
        Prefer a conversation? Schedule a 30-minute call.
      </p>
    </div>

    <div
      id="my-cal-inline-30min"
      class="mt-10 w-full"
      style="min-height:560px"
    />
  </section>

  {/* Cal.com loader */}
  <script is:inline defer>
    (function () {
      function loadCal() {
        (function (C, A, L) {
          let p = function (a, ar) { a.q.push(ar); };
          let d = C.document;
          C.Cal = C.Cal || function () {
            let cal = C.Cal; let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {}; cal.q = cal.q || [];
              d.head.appendChild(d.createElement("script")).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () { p(api, arguments); };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === "string") {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ["initNamespace", namespace]);
              } else { p(cal, ar); }
              return;
            }
            p(cal, ar);
          };
        })(window, "https://app.cal.eu/embed/embed.js", "init");

        Cal("init", "30min", { origin: "https://app.cal.eu" });
        Cal.ns["30min"]("inline", {
          elementOrSelector: "#my-cal-inline-30min",
          config: { layout: "month_view", useSlotsViewOnSmallScreen: "true" },
          calLink: "lucas-montes-9vahqq/30min",
        });
        Cal.ns["30min"]("ui", { hideEventTypeDetails: false, layout: "month_view" });
      }

      if ("requestIdleCallback" in window) {
        requestIdleCallback(loadCal, { timeout: 2500 });
      } else {
        setTimeout(loadCal, 1500);
      }
    })();
  </script>

  {/* Formspree AJAX — handles reCAPTCHA v3, AJAX, errors, success automatically */}
  <script is:inline>
    window.formspree = window.formspree || function () {
      (formspree.q = formspree.q || []).push(arguments);
    };
    formspree('initForm', { formElement: '#contact-form', formId: 'mpqbwvqj' });
  </script>
  <script src="https://unpkg.com/@formspree/ajax@1" defer></script>
</BaseLayout>
