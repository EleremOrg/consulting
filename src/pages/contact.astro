---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import { SITE } from '~/consts';

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${SITE.name}`,
  url: `${SITE.url}/contact`,
  mainEntity: {
    '@type': 'Organization',
    name: SITE.name,
    email: SITE.email,
    url: SITE.url,
  },
};
---

<BaseLayout
  title="Contact"
  description={`Start a conversation with ${SITE.name}. Tell us about your engineering challenge and we'll come back within one business day.`}
  jsonLd={[contactLd]}
>
  {/* ── Contact form ──────────────────────────────────────────────── */}
  <Section
    eyebrow="Contact"
    title="Let's talk about your engineering challenge"
    description="Tell us a little about what you're working on. We reply within one business day."
  >
    <form
      name="contact"
      method="POST"
      action="https://formspree.io/f/your-form-id"
      class="card mx-auto max-w-2xl space-y-5 p-6 sm:p-7"
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="name" class="block text-sm font-medium text-ink-900">Your name</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-ink-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-brand-500"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-ink-900">Work email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-ink-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-brand-500"
          />
        </div>
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-ink-900">How can we help?</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          placeholder="A sentence or two on the context is plenty."
          class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-ink-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-brand-500"
        ></textarea>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
        <button type="submit" class="btn-primary w-full sm:w-auto">Send message</button>
        <p class="text-xs text-slate-500">No marketing, ever. We reply within 1 business day.</p>
      </div>
    </form>
  </Section>

  {/* ── Cal.com inline embed (same as home page) ──────────────────── */}
  <section id="book" class="container-wide pb-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="flex justify-center"><span class="eyebrow">Or pick a slot directly</span></p>
      <h2 class="mt-3 h-section">Book a 30-min intro call</h2>
      <p class="mt-4 text-lg text-slate-600">
        No obligation. Or write to
        <a href={`mailto:${SITE.email}`} class="font-semibold text-brand-700 hover:text-brand-800">{SITE.email}</a>.
      </p>
    </div>

    <div
      id="my-cal-inline-30min"
      class="mt-10 w-full"
      style="min-height:560px"
    />
  </section>

  {/* Cal.com loader. is:inline emits the snippet verbatim (Cal's IIFE expects to run as-is).
      requestIdleCallback defers the network call for embed.js until the browser is idle,
      so first paint / LCP / INP are not affected for users who never reach this section. */}
  <script is:inline defer>
    (function () {
      function loadCal() {
        (function (C, A, L) {
          let p = function (a, ar) { a.q.push(ar); };
          let d = C.document;
          C.Cal = C.Cal || function () {
            let cal = C.Cal; let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {}; cal.q = cal.q || [];
              d.head.appendChild(d.createElement("script")).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () { p(api, arguments); };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === "string") {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ["initNamespace", namespace]);
              } else { p(cal, ar); }
              return;
            }
            p(cal, ar);
          };
        })(window, "https://app.cal.eu/embed/embed.js", "init");

        Cal("init", "30min", { origin: "https://app.cal.eu" });
        Cal.ns["30min"]("inline", {
          elementOrSelector: "#my-cal-inline-30min",
          config: { layout: "month_view", useSlotsViewOnSmallScreen: "true" },
          calLink: "lucas-montes-9vahqq/30min",
        });
        Cal.ns["30min"]("ui", { hideEventTypeDetails: false, layout: "month_view" });
      }

      if ("requestIdleCallback" in window) {
        requestIdleCallback(loadCal, { timeout: 2500 });
      } else {
        setTimeout(loadCal, 1500);
      }
    })();
  </script>
</BaseLayout>
