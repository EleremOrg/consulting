---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import { SITE } from '~/consts';

const services = [
  {
    id: 'architecture-review',
    title: 'Architecture & technical due diligence',
    summary:
      'Independent, written assessment of your software, team and delivery process — delivered in 2–4 weeks.',
    deliverables: [
      'Prioritised risk register with impact × likelihood scoring',
      'Target architecture and sequenced migration roadmap',
      'Team & process recommendations',
      'Executive-ready written report and readout',
    ],
    outcomes:
      'Investors, boards and executives get the honest, decision-grade picture they need. Teams get a concrete plan they actually believe in.',
  },
  {
    id: 'embedded-engineering',
    title: 'Hands-on senior engineering',
    summary:
      "We embed with your team to ship the work that's been stuck — platform migrations, data-heavy features, performance-critical systems.",
    deliverables: [
      'Production-ready code, reviewed and tested',
      'Pair programming and mentorship for your team',
      'Documentation, runbooks and architectural decision records',
      'Clean, confident handover',
    ],
    outcomes:
      'Your roadmap starts moving again, and your team levels up along the way — so momentum outlasts our engagement.',
  },
  {
    id: 'fractional-cto',
    title: 'Fractional CTO & technical leadership',
    summary:
      'For founders and growing teams who need senior technical judgement without (yet) committing to a full-time CTO hire.',
    deliverables: [
      'Hiring plans, role scorecards, interview loops',
      'Architectural direction and tradeoff framing',
      'Delivery process: planning, reviews, incident response',
      'Board- and investor-facing technical communication',
    ],
    outcomes:
      'You make better technical decisions faster, hire the right people, and present a credible engineering story to the outside world.',
  },
  {
    id: 'reliability',
    title: 'Reliability & performance engineering',
    summary:
      'SLOs, incident response, cost-aware scaling and Core Web Vitals work for products that customers cannot afford to see break.',
    deliverables: [
      'SLOs aligned to real customer journeys',
      'Error-budget policy and on-call process',
      'Performance budget and Core Web Vitals remediation',
      'Cost-to-serve analysis and reduction plan',
    ],
    outcomes:
      'Fewer fires, calmer deploys, happier users — and infra spend that scales sub-linearly with revenue.',
  },
];

// JSON-LD: list each offering as a Service under our Organization
const serviceLds = services.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  description: s.summary,
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  areaServed: 'Worldwide',
  serviceType: s.title,
  url: `${SITE.url}/services#${s.id}`,
}));
---

<BaseLayout
  title="Software consulting services"
  description="Architecture reviews, hands-on engineering, fractional CTO and reliability engineering — four ways Elerem helps ambitious teams ship resilient software faster."
  jsonLd={serviceLds}
>
  <Section
    eyebrow="Services"
    title="Senior-only consulting, four ways"
    description="Every engagement is scoped to a specific outcome, with a fixed-fee option wherever we can. No junior staff, no offshoring, no surprises."
  >
    <div class="grid gap-10 lg:grid-cols-12">
      {/* Sticky in-page nav at xl+ — Stripe Docs pattern */}
      <aside class="hidden lg:col-span-3 lg:block">
        <nav aria-label="Services" class="sticky top-28">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">
            Jump to
          </p>
          <ul class="mt-4 space-y-2 text-sm">
            {
              services.map((s, i) => (
                <li>
                  <a
                    href={`#${s.id}`}
                    class="group flex items-baseline gap-3 text-slate-600 hover:text-ink-900"
                  >
                    <span class="font-mono text-[10px] tracking-widest text-slate-400 group-hover:text-brand-600">
                      0{i + 1}
                    </span>
                    <span>{s.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href="/contact"
            class="mt-8 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800"
          >
            Book intro call <span aria-hidden="true">→</span>
          </a>
        </nav>
      </aside>

      <div class="lg:col-span-9">
        <div class="grid gap-6 md:grid-cols-2">
          {
            services.map((s, i) => (
              <article id={s.id} class="card scroll-mt-28 flex flex-col p-6 sm:p-7">
                <div class="flex items-baseline justify-between">
                  <p class="font-mono text-[11px] uppercase tracking-widest text-brand-600">
                    0{i + 1}
                  </p>
                  <a
                    href={`#${s.id}`}
                    aria-label={`Anchor link to ${s.title}`}
                    class="text-slate-300 hover:text-brand-600"
                  >
                    #
                  </a>
                </div>
                <h2 class="mt-3 text-xl font-bold tracking-tight text-ink-900">
                  {s.title}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.summary}</p>

                <div class="mt-5 border-t border-slate-100 pt-4">
                  <p class="text-[11px] font-semibold uppercase tracking-widest text-slate-500">
                    What you get
                  </p>
                  <ul class="mt-2.5 space-y-1.5 text-sm text-slate-700">
                    {s.deliverables.map((d) => (
                      <li class="flex gap-2">
                        <span aria-hidden="true" class="mt-1 text-accent-500">✓</span>
                        <span>{d}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-5 border-t border-slate-100 pt-4">
                  <p class="text-[11px] font-semibold uppercase tracking-widest text-slate-500">
                    Outcome
                  </p>
                  <p class="mt-2 text-sm leading-relaxed text-slate-700">{s.outcomes}</p>
                </div>
              </article>
            ))
          }
        </div>

        {/* Inline CTA at end of services grid */}
        <div class="mt-10 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/80 bg-sand-50 px-6 py-5">
          <p class="text-sm text-slate-700">
            Not sure which engagement fits? <span class="font-semibold text-ink-900">We'll help you scope it.</span>
          </p>
          <a href="/contact" class="btn-primary">Book intro call</a>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
