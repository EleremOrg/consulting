---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import { SITE } from '~/consts';

const services = [
  {
    id: 'architecture-review',
    title: 'Architecture & technical due diligence',
    summary:
      'Independent, written assessment of your software, team and delivery process — delivered in 2–4 weeks.',
    deliverables: [
      'Prioritised risk register with impact × likelihood scoring',
      'Target architecture and sequenced migration roadmap',
      'Team & process recommendations',
      'Executive-ready written report and readout',
    ],
    outcomes:
      'Investors, boards and executives get the honest, decision-grade picture they need. Teams get a concrete plan they actually believe in.',
  },
  {
    id: 'embedded-engineering',
    title: 'Hands-on senior engineering',
    summary:
      "We embed with your team to ship the work that's been stuck — platform migrations, data-heavy features, performance-critical systems.",
    deliverables: [
      'Production-ready code, reviewed and tested',
      'Pair programming and mentorship for your team',
      'Documentation, runbooks and architectural decision records',
      'Clean, confident handover',
    ],
    outcomes:
      'Your roadmap starts moving again, and your team levels up along the way — so momentum outlasts our engagement.',
  },
  {
    id: 'fractional-cto',
    title: 'Fractional CTO & technical leadership',
    summary:
      'For founders and growing teams who need senior technical judgement without (yet) committing to a full-time CTO hire.',
    deliverables: [
      'Hiring plans, role scorecards, interview loops',
      'Architectural direction and tradeoff framing',
      'Delivery process: planning, reviews, incident response',
      'Board- and investor-facing technical communication',
    ],
    outcomes:
      'You make better technical decisions faster, hire the right people, and present a credible engineering story to the outside world.',
  },
  {
    id: 'reliability',
    title: 'Reliability & performance engineering',
    summary:
      'SLOs, incident response, cost-aware scaling and Core Web Vitals work for products that customers cannot afford to see break.',
    deliverables: [
      'SLOs aligned to real customer journeys',
      'Error-budget policy and on-call process',
      'Performance budget and Core Web Vitals remediation',
      'Cost-to-serve analysis and reduction plan',
    ],
    outcomes:
      'Fewer fires, calmer deploys, happier users — and infra spend that scales sub-linearly with revenue.',
  },
];

// JSON-LD: list each offering as a Service under our Organization
const serviceLds = services.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  description: s.summary,
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  areaServed: 'Worldwide',
  serviceType: s.title,
  url: `${SITE.url}/services#${s.id}`,
}));
---

<BaseLayout
  title="Software consulting services"
  description="Architecture reviews, hands-on engineering, fractional CTO and reliability engineering — four ways Elerem helps ambitious teams ship resilient software faster."
  jsonLd={serviceLds}
>
  <Section
    eyebrow="Services"
    title="Senior-only software consulting, four ways"
    description="Every engagement is scoped to a specific outcome, with a fixed-fee option wherever we can. No junior staff, no offshoring, no surprises."
  >
    <div class="space-y-10">
      {
        services.map((s) => (
          <article id={s.id} class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            <h2 class="text-2xl font-bold tracking-tight">{s.title}</h2>
            <p class="mt-3 text-lg text-slate-600">{s.summary}</p>

            <div class="mt-6 grid gap-8 md:grid-cols-2">
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500">
                  What you get
                </h3>
                <ul class="mt-3 space-y-2 text-slate-700">
                  {s.deliverables.map((d) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true" class="mt-1 text-brand-500">✓</span>
                      <span>{d}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500">
                  Outcome
                </h3>
                <p class="mt-3 text-slate-700">{s.outcomes}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Section>
</BaseLayout>
