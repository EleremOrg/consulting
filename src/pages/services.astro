---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import { SITE } from '~/consts';

/* ──────────────────────────────────────────────────────────────────
   Three offerings, each with parallel structure:
     - what we do (concrete activities)
     - outcomes we measure (the numbers we commit to)
     - selected wins (real, anonymized — same source as home)
   The repetition is intentional: it's our methodology made visible.
   ────────────────────────────────────────────────────────────────── */
const offerings = [
  {
    id: 'code',
    eyebrow: 'Code',
    title: 'Codebase performance & quality',
    summary:
      "Your code works. It's also slow, expensive to run, hard to change, and untested in the places that matter most. We go in and fix that.",
    activities: [
      'Profile critical paths in Python, Rust, Postgres/MySQL, ETL and ML serving.',
      'Refactor hot spots — better data structures, algorithm choice, async, batching, caching.',
      'Migrate legacy services where ROI is clear (Flask → FastAPI, sync → async, sqlx, Tokio).',
      'Raise test coverage where coverage actually buys risk reduction (not vanity).',
      'Add observability so the change is provable in production, not just in staging.',
    ],
    outcomes: [
      'Latency (P50/P75/P99)',
      'CPU & memory usage',
      'Cloud bill & cost-to-serve',
      'Throughput & failure rate',
      'Test coverage on critical paths',
      'MTTR',
    ],
    wins: [
      {
        metric: '10×',
        label: 'lower latency',
        detail:
          'ML-serving microservice: 5s → <500ms via redesign and better data structures.',
      },
      {
        metric: '−80% memory',
        label: 'ETL 2h → 20min',
        detail:
          'Profiled and rewrote hot sections of an ETL pipeline; major resource and runtime reductions.',
      },
      {
        metric: '4× throughput',
        label: 'MySQL event store',
        detail:
          'Memory −70%, CPU −20%, failure rate −45%, MTTR −65% via query/index work and SRE practice.',
      },
      {
        metric: '−50% memory',
        label: 'Rust + Tokio proxy',
        detail:
          'Custom binary protocol; CPU −20%, memory −50% — better resource efficiency at scale.',
      },
    ],
    accent: 'from-brand-600 via-brand-700 to-ink-900',
  },
  {
    id: 'architecture',
    eyebrow: 'Architecture',
    title: 'Architecture for scale & change',
    summary:
      'We help you decide the next two years of platform direction — then ship the first slice with your team, so the plan survives contact with reality.',
    activities: [
      'Independent architecture review of platform, data flow and service boundaries.',
      'Migration strategy: monolith → services, sync → async, on-prem → cloud, vertical → distributed.',
      'Domain-driven decomposition (DDD, hexagonal, strangler-fig).',
      'Architecture decision records (ADRs) so future engineers know why, not just what.',
      'Pair with your team to ship the first migration slice — no over-the-wall handoff.',
    ],
    outcomes: [
      'Deploy frequency',
      'Lead time for change',
      'Service decoupling',
      'Time-to-onboard new engineers',
      'Architecture risk register closed',
      'Production incidents traced to architecture',
    ],
    wins: [
      {
        metric: '4 services',
        label: 'monolith → DDD',
        detail:
          'Refactored a Python distributed monolith into four hexagonal microservices with DDD; replaced Flask with FastAPI + Pydantic.',
      },
      {
        metric: '3× deploy freq',
        label: 'lead time −60%',
        detail:
          'E-commerce ingestion (Shopify / WooCommerce / PrestaShop) refactored with the strangler pattern; 10× throughput, 10× lower resource usage.',
      },
    ],
    accent: 'from-accent-500 via-accent-700 to-ink-900',
  },
  {
    id: 'culture',
    eyebrow: 'Culture & process',
    title: 'Engineering practice that compounds',
    summary:
      'Even great code rots in a team that ships slowly and reviews badly. We help build the engineering practice — not the org chart.',
    activities: [
      'Engineering metrics (DORA + custom KPIs) wired to dashboards your team actually looks at.',
      'Code review, branching and CI workflows that reduce friction without losing rigor.',
      'Mentoring through pair sessions, design reviews and ADR practice.',
      'Observability rollout: OpenTelemetry, Tempo (traces), Prometheus + Grafana (metrics), Loki (logs).',
      'Incident response and postmortem ritual that the team will actually run.',
    ],
    outcomes: [
      'Deploy frequency',
      'Lead time',
      'MTTR',
      'Code-review turnaround',
      'Onboarding time',
      'On-call sentiment',
    ],
    wins: [
      {
        metric: '92% coverage',
        label: 'from 12%',
        detail:
          'Across multiple services, plus AI model benchmarks (MAE, R², RMSE) for fast iteration on model changes.',
      },
      {
        metric: 'OTel rollout',
        label: 'distributed tracing',
        detail:
          'OpenTelemetry + Tempo + Prometheus/Grafana + Loki across a distributed system — measurable improvements in monitoring, debugging and reliability.',
      },
      {
        metric: 'MTTR −65%',
        label: 'SRE practice',
        detail:
          'Reduced incident time-to-recover via secure deployment practices, runbooks and 90% test coverage on critical paths.',
      },
    ],
    accent: 'from-amber-500 via-pink-500 to-brand-700',
  },
];

/* JSON-LD: each offering as a Service under our Organization */
const serviceLds = offerings.map((o) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: o.title,
  description: o.summary,
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  areaServed: 'Worldwide',
  serviceType: o.title,
  url: `${SITE.url}/services#${o.id}`,
}));
---

<BaseLayout
  title="Services"
  description="Three places we go deep: codebase performance & quality, architecture for scale & change, and the engineering practice that holds it together. Senior IC engineering, in your repo."
  jsonLd={serviceLds}
>
  <Section
    eyebrow="Services"
    title="Three places we go deep"
    description="We work where senior IC judgement compounds the most — code, architecture, and the engineering practice around them."
  >
    <div class="grid gap-12 lg:grid-cols-12">
      {/* Sticky TOC at lg+ */}
      <aside class="hidden lg:col-span-3 lg:block">
        <nav aria-label="Services" class="sticky top-28">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">
            Jump to
          </p>
          <ul class="mt-4 space-y-2 text-sm">
            {
              offerings.map((o, i) => (
                <li>
                  <a
                    href={`#${o.id}`}
                    class="group flex items-baseline gap-3 text-slate-600 hover:text-ink-900"
                  >
                    <span class="font-mono text-[10px] tracking-widest text-slate-400 group-hover:text-brand-600">
                      0{i + 1}
                    </span>
                    <span>{o.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href="/contact"
            class="mt-8 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800"
          >
            Book intro call <span aria-hidden="true">→</span>
          </a>
        </nav>
      </aside>

      <div class="lg:col-span-9">
        <div class="space-y-12">
          {
            offerings.map((o, i) => (
              <article id={o.id} class="scroll-mt-28">
                {/* Header strip with gradient accent */}
                <div
                  class:list={[
                    'relative overflow-hidden rounded-3xl bg-gradient-to-br p-8 text-white sm:p-10',
                    o.accent,
                  ]}
                >
                  <div aria-hidden="true" class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-white/15 blur-3xl"></div>
                  <div aria-hidden="true" class="absolute -left-16 bottom-[-6rem] h-56 w-56 rounded-full bg-accent-300/20 blur-3xl"></div>

                  <p class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/90 backdrop-blur">
                    0{i + 1} · {o.eyebrow}
                  </p>
                  <h2 class="relative mt-5 max-w-2xl text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
                    {o.title}
                  </h2>
                  <p class="relative mt-4 max-w-xl text-white/85">{o.summary}</p>
                </div>

                {/* Two-column body: what we do · outcomes we measure */}
                <div class="mt-6 grid gap-6 lg:grid-cols-12">
                  <div class="card lg:col-span-7 p-6 sm:p-7">
                    <p class="text-[11px] font-semibold uppercase tracking-widest text-slate-500">
                      What we do
                    </p>
                    <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-slate-700">
                      {o.activities.map((a) => (
                        <li class="flex gap-2">
                          <span aria-hidden="true" class="mt-1 text-accent-500">→</span>
                          <span>{a}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="card-tinted lg:col-span-5 p-6 sm:p-7">
                    <p class="text-[11px] font-semibold uppercase tracking-widest text-slate-500">
                      Outcomes we measure
                    </p>
                    <ul class="mt-3 grid grid-cols-1 gap-1.5 text-sm text-slate-700 sm:grid-cols-2">
                      {o.outcomes.map((m) => (
                        <li class="flex items-start gap-2">
                          <span aria-hidden="true" class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>
                          <span>{m}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                {/* Selected wins specific to this offering */}
                <div class="mt-6">
                  <p class="text-[11px] font-semibold uppercase tracking-widest text-slate-500">
                    Selected wins
                  </p>
                  <ul class="mt-3 grid gap-4 sm:grid-cols-2">
                    {o.wins.map((w) => (
                      <li class="rounded-2xl border border-slate-200/80 bg-white p-5">
                        <div class="flex items-baseline justify-between gap-3">
                          <p class="font-display text-2xl font-bold tracking-tight text-ink-900">
                            {w.metric}
                          </p>
                          <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                            {w.label}
                          </p>
                        </div>
                        <p class="mt-2 text-sm leading-relaxed text-slate-600">
                          {w.detail}
                        </p>
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>

        {/* Inline CTA at end of services list */}
        <div class="mt-12 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/80 bg-sand-50 px-6 py-5">
          <p class="text-sm text-slate-700">
            Not sure which engagement fits?
            <span class="font-semibold text-ink-900">We'll help you scope it.</span>
          </p>
          <a href="/contact" class="btn-primary">Book intro call</a>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
