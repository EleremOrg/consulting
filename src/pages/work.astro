---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';

const cases = [
  {
    client: 'Series B fintech platform',
    title: 'From monolithic legacy to strangler-fig in six months',
    challenge:
      'A five-year-old payments monolith was slowing the team to a crawl and blocking a strategic partnership integration.',
    work: [
      'Full architecture review with prioritised risk register',
      'Designed a strangler-fig migration around payment intents',
      'Embedded a two-person team for 5 months to ship the first three slices to production',
    ],
    outcome:
      'Integration shipped on time. Deploy frequency up 4×, median deploy-to-prod time down from 3h to 12 minutes.',
  },
  {
    client: 'Early-stage SaaS startup',
    title: 'Fractional CTO through a Series A',
    challenge:
      'Two technical co-founders needed senior technical judgement on hiring, architecture and investor conversations — but a full-time CTO was the wrong shape for the stage.',
    work: [
      'Fractional CTO engagement — 2 days/week for 9 months',
      'Hiring plan, scorecards and interview loop that scaled engineering from 4 to 14',
      'Architectural north star and delivery process',
    ],
    outcome:
      'Closed Series A with strong technical due diligence. Engineering org stayed shippable through the scale-up.',
  },
  {
    client: 'Data-heavy B2B product',
    title: 'Core Web Vitals & performance turnaround',
    challenge:
      "User-facing dashboard was slow enough that enterprise customers were raising it in QBRs — but the team didn't know where to start.",
    work: [
      'Real-user monitoring rollout and performance budget',
      'Targeted remediation: bundle splitting, server-side pagination, query caching',
      'Pairing sessions to level up the in-house team',
    ],
    outcome:
      'LCP improved from 4.8s to 1.6s at P75. Two at-risk enterprise renewals saved.',
  },
];
---

<BaseLayout
  title="Case studies"
  description="Selected software consulting engagements from Elerem — architecture reviews, platform modernization, fractional CTO and performance turnarounds."
>
  <Section
    eyebrow="Work"
    title="Selected engagements"
    description="A sample of recent engagements. Names withheld where clients haven't published their relationship publicly — happy to share references on request."
  >
    <div class="space-y-10">
      {
        cases.map((c) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">{c.client}</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight">{c.title}</h2>

            <div class="mt-6 grid gap-8 md:grid-cols-3">
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Challenge</h3>
                <p class="mt-2 text-slate-700">{c.challenge}</p>
              </div>
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500">What we did</h3>
                <ul class="mt-2 space-y-2 text-slate-700">
                  {c.work.map((w) => (
                    <li class="flex gap-2"><span class="mt-1 text-brand-500" aria-hidden="true">→</span><span>{w}</span></li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Outcome</h3>
                <p class="mt-2 text-slate-700">{c.outcome}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Section>
</BaseLayout>
