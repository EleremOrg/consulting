---
/**
 * Header — reactive sticky header.
 *
 * Two visual states, driven by `data-scrolled` on <header>:
 *
 *  • At top of page (data-scrolled="false"):
 *      - Edge-to-edge clean bar, full container width, h-20.
 *
 *  • Scrolled (data-scrolled="true"):
 *      - Bar contracts into a centered floating PILL: narrower max-width,
 *        rounded, soft shadow, glass background, h-12.
 *      - A short scroll-progress hairline sits at the bottom edge of the pill.
 *
 * The transition is pure CSS; the only JS is a rAF-throttled scroll listener
 * that flips `data-scrolled` past 24px and updates --scroll-progress.
 *
 * No nav links right now (single-page site). The CTA is the only control.
 */
import { NAV_LINKS, SITE } from '~/consts';
---

<header data-scrolled="false" class="site-header">
  <div class="site-header__bar">
    <div class="site-header__inner">
      {/* Brand */}
      <a href="/" class="brand" aria-label={`${SITE.name} — Home`}>
        <span class="brand__mark" aria-hidden="true">
          <span class="relative z-10">E</span>
          <span class="brand__mark-shine" aria-hidden="true"></span>
        </span>
        <span class="brand__name">{SITE.name}</span>
      </a>

      {/* Right cluster */}
      <div class="flex items-center gap-2">
        {NAV_LINKS.length > 0 && (
          <nav aria-label="Primary" class="hidden md:block">
            <ul class="flex items-center gap-1">
              {NAV_LINKS.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:text-ink-900"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        {/* Primary CTA — gradient pill */}
        <a href="/contact" class="cta">
          <span>Book intro call</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
            class="cta__arrow"
          >
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L11.47 6.31a.75.75 0 111.06-1.06l4.25 4.25a.75.75 0 010 1.06l-4.25 4.25a.75.75 0 11-1.06-1.06l2.918-2.94H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</header>

<style>
  /* ── Header shell (sticky, transparent — chrome lives on the inner bar) */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
  }

  /* ── Outer band — clean white at top, transparent gutter when scrolled
        (so the inner bar appears to float). */
  .site-header__bar {
    background-color: rgb(255 255 255 / 90%);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid rgb(226 232 240 / 70%); /* slate-200 @ 70% */
    transition:
      background-color 240ms ease-out,
      border-color 240ms ease-out,
      padding 240ms ease-out;
    padding-inline: 0;
    padding-block: 0;
  }
  .site-header[data-scrolled='true'] .site-header__bar {
    background-color: transparent;
    border-bottom-color: transparent;
    padding-inline: 1rem;
    padding-block: 0.5rem;
  }

  /* ── Inner — the actual visible bar. Becomes a centered floating pill when scrolled. */
  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: auto;
    width: 100%;
    max-width: 80rem; /* matches container-wide on lg+ */
    padding-inline: 1rem;
    height: 5rem; /* h-20 */
    border-radius: 0;
    background-color: transparent;
    box-shadow: none;
    transition:
      max-width 320ms cubic-bezier(0.22, 1, 0.36, 1),
      height 240ms ease-out,
      padding 240ms ease-out,
      border-radius 320ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 240ms ease-out,
      box-shadow 240ms ease-out;
  }
  @media (min-width: 640px) {
    .site-header__inner { padding-inline: 1.5rem; }
  }
  @media (min-width: 1024px) {
    .site-header__inner { padding-inline: 2rem; }
  }

  .site-header[data-scrolled='true'] .site-header__inner {
    height: 3.75rem; /* taller — chunkier */
    max-width: 22rem; /* narrower pill, but wide enough for larger contents */
    padding-inline: 0.5rem;
    padding-block: 0;
    border-radius: 9999px;
    background-color: rgb(255 255 255 / 85%);
    backdrop-filter: saturate(160%) blur(10px);
    box-shadow:
      0 1px 0 0 rgb(255 255 255 / 60%) inset,
      0 10px 28px -12px rgb(11 16 32 / 22%),
      0 2px 6px -2px rgb(11 16 32 / 8%);
  }

  /* ── Brand ────────────────────────────────────────────────────── */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-ink-900);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .brand__mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 2.25rem;
    height: 2.25rem;
    aspect-ratio: 1 / 1;
    border-radius: 50% !important;
    overflow: hidden;
    color: white;
    font-weight: 700;
    font-size: 0.875rem;
    background-image: linear-gradient(
      135deg,
      var(--color-brand-500),
      var(--color-brand-700) 55%,
      var(--color-accent-600)
    );
    box-shadow: 0 1px 2px rgb(11 16 32 / 8%);
    transition:
      width 240ms ease-out,
      height 240ms ease-out,
      font-size 240ms ease-out,
      border-radius 240ms ease-out;
  }
  .site-header[data-scrolled='true'] .brand__mark {
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1rem;
    border-radius: 50% !important;
  }
  .brand__mark-shine {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: linear-gradient(135deg, rgb(255 255 255 / 30%), transparent 60%);
    opacity: 0;
    transition: opacity 200ms ease-out;
    pointer-events: none;
  }
  .brand:hover .brand__mark-shine { opacity: 1; }

  .brand__name {
    font-size: 1.125rem;
    line-height: 1;
    transition: font-size 240ms ease-out;
  }
  .site-header[data-scrolled='true'] .brand__name {
    font-size: 1rem;
  }

  /* ── CTA ──────────────────────────────────────────────────────── */
  .cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    color: white;
    font-size: 0.875rem;
    font-weight: 600;
    background-image: linear-gradient(
      135deg,
      var(--color-brand-600),
      var(--color-brand-700) 55%,
      var(--color-accent-600)
    );
    box-shadow: 0 1px 2px rgb(11 16 32 / 10%);
    transition:
      transform 200ms ease-out,
      box-shadow 200ms ease-out,
      padding 240ms ease-out,
      font-size 240ms ease-out;
    white-space: nowrap;
  }
  .site-header[data-scrolled='true'] .cta {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }
  .cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px -6px rgb(63 54 184 / 35%);
  }
  .cta__arrow {
    width: 0.875rem;
    height: 0.875rem;
    margin-right: -0.125rem;
    transition: transform 200ms ease-out;
  }
  .cta:hover .cta__arrow { transform: translateX(2px); }



  /* ── Reduced motion ─────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .site-header__bar,
    .site-header__inner,
    .brand__mark,
    .brand__mark-shine,
    .brand__name,
    .cta,
    .cta__arrow {
      transition: none !important;
    }
  }

  /* ── On very small screens, don't shrink the pill to absurd width.
        Keep it nearly full-width with side gutters. */
  @media (max-width: 479px) {
    .site-header[data-scrolled='true'] .site-header__inner {
      max-width: calc(100% - 1rem);
    }
  }
</style>

<script is:inline>
  (function () {
    const header = document.querySelector('header.site-header');
    if (!header) return;

    let ticking = false;

    function update() {
      const y = window.scrollY || window.pageYOffset || 0;
      const flag = y > 24 ? 'true' : 'false';
      if (header.dataset.scrolled !== flag) header.dataset.scrolled = flag;
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    }

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  })();
</script>
