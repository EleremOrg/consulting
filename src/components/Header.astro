---
import { NAV_LINKS, SITE } from '~/consts';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/85 backdrop-blur supports-[backdrop-filter]:bg-white/70">
  <div class="container-wide flex h-16 items-center justify-between">
    <a
      href="/"
      class="flex items-center gap-2 text-ink-900 font-semibold tracking-tight"
      aria-label={`${SITE.name} — Home`}
    >
      <span
        class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-brand-500 via-brand-700 to-accent-600 text-white font-bold"
        aria-hidden="true">E</span
      >
      <span class="text-lg">{SITE.name}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          NAV_LINKS.map((link) => {
            const active =
              pathname === link.href || pathname.startsWith(link.href + '/');
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'relative px-3 py-2 text-sm font-medium transition-colors',
                    active
                      ? 'text-ink-900'
                      : 'text-slate-600 hover:text-ink-900',
                  ]}
                >
                  {link.label}
                  {active && (
                    <span
                      aria-hidden="true"
                      class="absolute inset-x-3 -bottom-[17px] h-0.5 rounded-full bg-brand-600"
                    />
                  )}
                </a>
              </li>
            );
          })
        }
        <li>
          <a href="/contact" class="btn-primary ml-3 !px-4 !py-2">Book intro call</a>
        </li>
      </ul>
    </nav>

    <details class="md:hidden relative">
      <summary
        class="list-none cursor-pointer rounded-md p-2 text-slate-700 hover:bg-slate-100"
        aria-label="Open navigation menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </summary>
      <nav
        aria-label="Mobile"
        class="absolute right-0 mt-2 w-60 rounded-lg border border-slate-200 bg-white shadow-lg p-2"
      >
        <ul class="flex flex-col">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li class="mt-1 border-t border-slate-100 pt-1">
            <a
              href="/contact"
              class="block rounded-md bg-brand-600 px-3 py-2 text-sm font-semibold text-white hover:bg-brand-700"
            >
              Book intro call →
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
