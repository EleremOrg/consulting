---
/**
 * Hero — asymmetric 7/5 layout with a colourful gradient-orb composition.
 *  - Left (7 cols): eyebrow, headline (with gradient accent), sub, CTAs, trust line.
 *  - Right (5 cols): purely aesthetic abstract gradient orbs in a glass tile.
 */
export interface Props {
  eyebrow?: string;
  title: string;
  /** Optional accent word(s) inside the title rendered with the brand gradient. */
  titleAccent?: string;
  description: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
}
const {
  eyebrow,
  title,
  titleAccent,
  description,
  primaryCta,
  secondaryCta,
} = Astro.props;
---

<section class="relative isolate overflow-hidden border-b border-slate-200/60 bg-white">
  {/* Layered gradient mesh background */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    {/* Top-left indigo wash */}
    <div class="absolute -top-32 -left-32 h-[36rem] w-[36rem] rounded-full bg-brand-300/40 blur-3xl"></div>
    {/* Top-right teal wash */}
    <div class="absolute -top-24 right-[-10%] h-[30rem] w-[30rem] rounded-full bg-accent-300/40 blur-3xl"></div>
    {/* Bottom soft sand */}
    <div class="absolute bottom-[-12rem] left-1/3 h-[26rem] w-[40rem] rounded-full bg-sand-100/80 blur-3xl"></div>
  </div>

  {/* Faint grid overlay for texture */}
  <div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-50 [mask-image:radial-gradient(ellipse_at_top,black_25%,transparent_75%)]"></div>

  <div class="container-wide relative py-16 sm:py-24 lg:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
      {/* Left column — message */}
      <div class="lg:col-span-7">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="mt-5 h-display max-w-2xl text-ink-900">
          {title}
          {titleAccent && (
            <>
              {' '}
              <span class="text-gradient-brand">{titleAccent}</span>
            </>
          )}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">{description}</p>
        {
          (primaryCta || secondaryCta) && (
            <div class="mt-8 flex flex-wrap gap-3">
              {primaryCta && <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>}
              {secondaryCta && <a href={secondaryCta.href} class="btn-ghost">{secondaryCta.label}</a>}
            </div>
          )
        }

        {/* Trust line */}
        <p class="mt-8 flex items-center gap-3 text-xs text-slate-500">
          <span class="inline-flex -space-x-1.5">
            <span class="h-5 w-5 rounded-full border-2 border-white bg-brand-500"></span>
            <span class="h-5 w-5 rounded-full border-2 border-white bg-accent-500"></span>
            <span class="h-5 w-5 rounded-full border-2 border-white bg-brand-700"></span>
          </span>
          Senior partners only — no junior staff, no offshoring, no surprises.
        </p>
      </div>

      {/* Right column — abstract gradient-orb composition */}
      <aside class="lg:col-span-5">
        <div class="relative aspect-square w-full overflow-hidden rounded-3xl border border-white/40 bg-white/30 shadow-xl shadow-brand-900/5 backdrop-blur-xl">
          {/* Gradient orbs */}
          <div aria-hidden="true" class="absolute inset-0">
            <div class="absolute -top-10 -left-8 h-56 w-56 rounded-full bg-gradient-to-br from-brand-400 to-brand-700 opacity-90 blur-2xl"></div>
            <div class="absolute top-1/3 right-[-3rem] h-64 w-64 rounded-full bg-gradient-to-br from-accent-300 to-accent-600 opacity-80 blur-2xl"></div>
            <div class="absolute bottom-[-4rem] left-1/4 h-56 w-56 rounded-full bg-gradient-to-br from-pink-300 via-brand-400 to-brand-600 opacity-70 blur-2xl"></div>
            <div class="absolute bottom-6 right-10 h-32 w-32 rounded-full bg-gradient-to-br from-sand-100 to-amber-200 opacity-80 blur-xl"></div>
          </div>

          {/* Sharp accent ring (foreground geometry) */}
          <div aria-hidden="true" class="absolute inset-0 grid place-items-center">
            <div class="relative h-[58%] w-[58%] rounded-full border border-white/50 bg-white/10 backdrop-blur-md">
              <div class="absolute inset-3 rounded-full border border-white/40"></div>
              <div class="absolute inset-8 rounded-full bg-gradient-to-br from-white/70 via-white/20 to-transparent"></div>
            </div>
          </div>

          {/* Floating glass chips */}
          <div aria-hidden="true" class="absolute left-6 top-6 rounded-xl border border-white/50 bg-white/40 px-3 py-2 text-[10px] font-mono uppercase tracking-widest text-ink-900 backdrop-blur-md shadow-sm">
            <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-accent-500"></span>
            shipping
          </div>
          <div aria-hidden="true" class="absolute bottom-6 right-6 rounded-xl border border-white/50 bg-white/40 px-3 py-2 text-[10px] font-mono uppercase tracking-widest text-ink-900 backdrop-blur-md shadow-sm">
            P75 · 1.6s
          </div>
          <div aria-hidden="true" class="absolute bottom-1/3 left-4 rounded-xl border border-white/50 bg-white/40 px-3 py-2 text-[10px] font-mono uppercase tracking-widest text-ink-900 backdrop-blur-md shadow-sm">
            SLO 99.95
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
