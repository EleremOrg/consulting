---
/**
 * SectionHeader — used at the top of marketing sections.
 *
 * Offers two layouts:
 *  - default (stacked):       eyebrow / title / description vertically, max-w-2xl.
 *  - layout="side":           designed for use inside a 12-column grid where the
 *                              header takes col-span-5 and content takes col-span-7,
 *                              giving a Stripe-style asymmetric reading flow.
 */
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /** When `side`, drops the max-width so the parent grid controls column. */
  layout?: 'stacked' | 'side';
  /** Optional align override for stacked variant. */
  align?: 'start' | 'center';
  /** Optional html tag for the heading element (default h2). */
  as?: 'h1' | 'h2' | 'h3';
}

const {
  eyebrow,
  title,
  description,
  layout = 'stacked',
  align = 'start',
  as: HeadingTag = 'h2',
} = Astro.props;

const widthClass =
  layout === 'side'
    ? ''
    : align === 'center'
      ? 'mx-auto max-w-3xl text-center'
      : 'max-w-2xl';
---

<header class={widthClass}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <HeadingTag class="mt-3 h-section">{title}</HeadingTag>
  {description && <p class="mt-4 text-lg text-slate-600">{description}</p>}
</header>
