---
import { SITE } from '~/consts';
const year = new Date().getFullYear();

const linkedin = SITE.sameAs.find((u) => u.includes('linkedin.com'));

const links: ReadonlyArray<{ href: string; label: string }> = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  // { href: '/blog', label: 'Blog' }, // hidden until first post is published
  { href: '/contact', label: 'Contact' },
];
---

<footer class="mt-20 border-t border-slate-200/70 bg-sand-50/60">
  <div class="container-wide flex flex-col items-start justify-between gap-6 py-10 md:flex-row md:items-center">
    {/* Logo + slogan */}
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2" aria-label={`${SITE.name} — Home`}>
        <span
          class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-brand-500 via-brand-700 to-accent-600 text-white font-bold"
          aria-hidden="true"
        >E</span>
        <span class="font-display text-lg font-semibold text-ink-900">{SITE.name}</span>
      </a>
      <span aria-hidden="true" class="hidden h-4 w-px bg-slate-300 md:block"></span>
      <p class="hidden text-sm text-slate-600 md:block">{SITE.tagline}</p>
    </div>

    {/* Links */}
    <nav aria-label="Footer" class="text-sm">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {links.map((l) => (
          <li>
            <a href={l.href} class="text-slate-600 hover:text-ink-900">{l.label}</a>
          </li>
        ))}
        {linkedin && (
          <li>
            <a
              href={linkedin}
              class="text-slate-600 hover:text-ink-900"
              rel="me noopener"
              target="_blank"
            >
              LinkedIn
            </a>
          </li>
        )}
      </ul>
    </nav>
  </div>

  <div class="container-wide border-t border-slate-200/70 py-5 text-xs text-slate-500">
    <p>© {year} {SITE.legalName}. All rights reserved.</p>
  </div>
</footer>
